+pub fn set_partitions_ro() -> i32 {
+    use std::os::unix::fs::FileTypeExt;
+    use std::os::unix::io::AsRawFd;
+
+    const PARTITIONS: &[&str] = &[
+        "boot",
+        "dtbo",
+        "init_boot",
+        "vendor_boot",
+        "super",
+        "optics",
+        "prism",
+        "vbmeta",
