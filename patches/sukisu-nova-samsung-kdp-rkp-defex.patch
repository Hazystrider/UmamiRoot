+            let path = format!("/dev/block/by-name/{base}{suffix}");
+
+            let std::result::Result::Ok(file) = std::fs::File::open(&path) else {
+                continue;
+            };
+
+            match file.metadata() {
+                std::result::Result::Ok(m) if m.file_type().is_block_device() => {}
+                _ => continue,
+            }
+
